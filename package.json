{
  "name": "uncam",
  "productName": "UnCam",
  "version": "0.1.0",
  "description": "UnCam",
  "author": "VegasDev",
  "main": "main.js",
  "scripts": {
    "test": "node test/lib.test.js && node test/proto.test.js",
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vegasdev.uncam",
    "productName": "UnCam",
    "icon": "build/icon.png",
    "copyright": "© 2026 VegasDev",
    "files": ["main.js", "preload.js", "proto.js", "src/**", "build/icon.png", "package.json"],
    "extraResources": [{ "from": "scrcpy", "to": "scrcpy" }],
    "win": { "target": ["nsis"] },
    "nsis": {
      "artifactName": "UnCam-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["ru_RU"],
      "language": "1049",
      "createDesktopShortcut": true,
      "shortcutName": "UnCam",
      "runAfterFinish": true,
      "perMachine": false
    },
    "publish": [{ "provider": "github", "owner": "Airi-Drun-System", "repo": "UnCam", "releaseType": "release" }]
  }
}
